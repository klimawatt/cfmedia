---
import type { ServiceContentBlock } from '../data/services';
import { cleanHtml } from '../lib/html';
import FaqList from './FaqList.astro';

interface Props {
  blocks: ServiceContentBlock[];
}

const { blocks } = Astro.props;
---

<div class="content-blocks">
  {blocks.map((block, blockIndex) => block.type === 'steps' ? (
    <section class="step-section" aria-labelledby={`service-block-${blockIndex}`}>
      <div class="container step-layout">
        <header class="step-heading">
          <p class="eyebrow">{block.eyebrow}</p>
          <h2 id={`service-block-${blockIndex}`}>{block.title}</h2>
          <p>{block.intro}</p>
        </header>
        <ol class="step-list">
          {block.steps.map((step, index) => (
            <li class="step-item">
              <span class="step-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <article class="step-content">
                <p class="step-phase">{step.phase}</p>
                <h3>{step.title}</h3>
                <p class="step-description">{step.description}</p>
                {step.tags.length > 0 && <ul class="step-tags" aria-label="Onderwerpen">{step.tags.map((tag) => <li>{tag}</li>)}</ul>}
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ) : block.type === 'text' ? (
    <section class="text-section" aria-labelledby={`service-block-${blockIndex}`}>
      <div class="container text-layout">
        <p class="eyebrow">{block.eyebrow}</p>
        <div class="rich"><h2 id={`service-block-${blockIndex}`}>{block.title}</h2>{block.html ? <Fragment set:html={cleanHtml(block.html)} /> : (block.paragraphs ?? []).map((paragraph) => <p>{paragraph}</p>)}</div>
      </div>
    </section>
  ) : block.type === 'checklist' ? (
    <section class="text-section" aria-labelledby={`service-block-${blockIndex}`}>
      <div class="container text-layout">
        <p class="eyebrow">{block.eyebrow}</p>
        <div><h2 id={`service-block-${blockIndex}`}>{block.title}</h2><ul class="check-list">{block.items.map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </section>
  ) : block.type === 'callout' ? (
    <section class="callout-section" aria-labelledby={`service-block-${blockIndex}`}>
      <div class="container callout">
        <div><p class="eyebrow">{block.eyebrow}</p><h2 id={`service-block-${blockIndex}`}>{block.title}</h2><p>{block.text}</p></div>
        {block.buttonLabel && block.buttonHref && <a class="button-primary" href={block.buttonHref}>{block.buttonLabel} <span aria-hidden="true">↗</span></a>}
      </div>
    </section>
  ) : (
    <section class="text-section" aria-labelledby={`service-block-${blockIndex}`}>
      <div class="container text-layout">
        <p class="eyebrow">{block.eyebrow}</p>
        <div><h2 id={`service-block-${blockIndex}`}>{block.title}</h2><FaqList questions={block.questions} /></div>
      </div>
    </section>
  ))}
</div>

<style>
  .step-section { padding-block: 4.5rem; border-top: 1px solid var(--line); }
  .step-layout { display: grid; grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 5rem); }
  .step-heading { align-self: start; }
  .step-heading h2, .text-layout h2 { max-width: 13ch; margin: 0.5rem 0 0.8rem; font-size: var(--type-h2); line-height: 1.05; }
  .step-heading > p:last-child, .text-layout div > p { max-width: 38rem; color: var(--muted); line-height: 1.7; }
  .step-list { position: relative; display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .step-list::before { position: absolute; top: 1.6rem; bottom: 1.6rem; left: 1.45rem; width: 1px; background: var(--line); content: ''; }
  .step-item { position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: start; gap: 1.15rem; }
  .step-marker { position: relative; z-index: 1; display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid var(--accent); background: var(--paper); color: var(--accent); font-family: 'Space Grotesk Variable', sans-serif; font-size: 0.95rem; font-weight: 700; }
  .step-content { min-width: 0; padding: 0.1rem 0 1.8rem; border-bottom: 1px solid var(--line); }
  .step-item + .step-item .step-content { padding-top: 1.2rem; }
  .step-phase { margin: 0; color: var(--accent); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .step-content h3 { margin: 0.35rem 0 0.45rem; font-size: 1.35rem; }
  .step-description { max-width: 48rem; margin: 0; color: var(--muted); line-height: 1.65; }
  .step-tags { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; margin: 0.85rem 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 0.72rem; }
  .step-tags li + li::before { margin-right: 0.8rem; color: var(--accent); content: '/'; }
  .text-section { padding-block: 3rem; background: var(--surface-soft); }
  .text-layout { display: grid; grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 5rem); }
  .text-layout h2 { margin-top: 0; }
  .text-layout div > p { margin-block: 0 0.8rem; }
  .rich :global(h3) { margin: 1.6rem 0 0.5rem; font-size: 1.35rem; }
  .rich :global(h4) { margin: 1.3rem 0 0.4rem; font-size: 1.1rem; }
  .rich :global(ul), .rich :global(ol) { max-width: 38rem; padding-left: 1.3rem; color: var(--muted); line-height: 1.7; }
  .rich :global(a) { color: var(--accent); text-underline-offset: 0.2em; }
  .rich :global(blockquote) { margin: 1.5rem 0; padding: 0.8rem 1.2rem; border-left: 3px solid var(--accent); background: var(--surface); color: var(--ink); }
  .rich :global(code) { padding: 0.1rem 0.3rem; background: var(--surface-soft); font-size: 0.92em; }
  .rich :global(pre) { max-width: 100%; margin: 1.2rem 0; padding: 1rem; overflow-x: auto; background: var(--night); color: var(--night-ink); font-size: 0.85rem; line-height: 1.5; }
  .rich :global(pre code) { padding: 0; background: transparent; }
  .check-list { display: grid; gap: 0.7rem; max-width: 38rem; margin: 0; padding: 0; list-style: none; }
  .check-list li { position: relative; padding: 0.7rem 0 0.7rem 2rem; border-bottom: 1px solid var(--line); line-height: 1.5; }
  .check-list li::before { position: absolute; top: 0.7rem; left: 0; color: var(--accent); font-weight: 700; content: '✓'; }
  .callout-section { padding-block: 3rem; }
  .callout { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); background: var(--night); color: var(--night-ink); }
  .callout .eyebrow { color: var(--accent-on-dark); }
  .callout h2 { max-width: 18ch; margin: 0.4rem 0; font-size: var(--type-h2-medium); line-height: 1.1; }
  .callout p:not(.eyebrow) { max-width: 36rem; margin: 0; color: var(--night-muted); line-height: 1.6; }
  @media (max-width: 720px) { .callout { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 720px) { .step-layout, .text-layout { grid-template-columns: 1fr; gap: 1.5rem; } .step-heading h2, .text-layout h2 { font-size: var(--type-h2-medium); } }
</style>