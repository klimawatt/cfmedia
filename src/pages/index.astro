---
import SiteLayout from '../layouts/SiteLayout.astro';

const services = [
  { number: '01', name: 'SEO', description: 'Maak je website beter vindbaar in organische zoekresultaten.', href: '/diensten/seo/' },
  { number: '02', name: 'GEO', description: 'Maak je informatie vindbaar in ChatGPT, Perplexity en Google AI Overviews.', href: '/diensten/geo/' },
  { number: '03', name: 'Webdesign', description: 'Een heldere, toegankelijke website die prettig werkt op ieder scherm.', href: '/diensten/webdesign/' },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'CF Media',
  url: 'https://www.cfmedia.nl/',
  logo: 'https://www.cfmedia.nl/images/cfmedia-logo.svg',
  description: 'Nederlands bureau voor SEO, GEO en webdesign.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '[ADRES INVULLEN]',
    addressCountry: 'NL',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: '[E-MAIL INVULLEN]',
    telephone: '[TELEFOON INVULLEN]',
  },
  sameAs: [],
};
---

<SiteLayout
  title="CF Media | SEO, GEO en webdesign"
  description="CF Media helpt je met SEO, GEO en webdesign. Maak je website beter vindbaar en prettiger in gebruik."
  canonical="https://www.cfmedia.nl/"
  structuredData={organization}
>
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">CF Media · SEO · GEO · webdesign</p>
      <h1>Gevonden worden begint met een goed fundament.</h1>
      <p class="intro">We helpen je website beter vindbaar te maken in zoekmachines en AI, en prettiger te laten werken voor je bezoekers.</p>
      <a class="button-primary" href="/contact/">Plan een gesprek <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-index" aria-hidden="true"><span>CF</span><span>MEDIA</span><span>NL · 01</span></div>
  </section>

  <section class="container services section-space" aria-labelledby="services-heading">
    <div class="section-heading"><p class="eyebrow">Wat we doen</p><h2 id="services-heading">Werk aan je online basis.</h2></div>
    <div class="service-list">
      {services.map((service) => <a class="service-row" href={service.href}><span>{service.number}</span><div><h3>{service.name}</h3><p>{service.description}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
    </div>
  </section>

  <section class="proof-band" aria-labelledby="cases-heading">
    <div class="container proof-inner">
      <div><p class="eyebrow">Werk in de praktijk</p><h2 id="cases-heading">Cases, zodra ze verteld mogen worden.</h2><p>We vullen deze plek met klantwerk na toestemming en controle van de inhoud.</p><a class="text-link" href="/cases/">Bekijk de case-opzet <span aria-hidden="true">↗</span></a></div>
      <div class="case-placeholder"><span>CASE 01</span><strong>[CASE: klantnaam + resultaat invullen]</strong><a href="/cases/case-invullen/">Bekijk de invulopzet</a></div>
    </div>
  </section>

  <section class="container logo-section" aria-labelledby="logos-heading">
    <p class="eyebrow">Samenwerkingen</p><h2 id="logos-heading">Logo’s verschijnen hier met toestemming.</h2>
    <div class="logo-placeholders"><span>[LOGO KLANT 1 INVULLEN]</span><span>[LOGO KLANT 2 INVULLEN]</span><span>[LOGO KLANT 3 INVULLEN]</span></div>
  </section>

  <section class="process-section">
    <div class="container process-inner">
      <div><p class="eyebrow">Zo werken we</p><h2>Van vraag naar volgende stap.</h2></div>
      <ol><li><span>01</span><h3>Verkennen</h3><p>We bespreken je vraag, doelen en huidige website.</p></li><li><span>02</span><h3>Kiezen</h3><p>We brengen opties in kaart en bepalen wat eerst moet.</p></li><li><span>03</span><h3>Verbeteren</h3><p>We voeren het werk uit en bespreken wat de volgende stap is.</p></li></ol>
    </div>
  </section>

  <section class="container final-cta">
    <p class="eyebrow">Samen aan de slag</p><h2>Waar wil je je website mee vooruithelpen?</h2><a class="button-primary" href="/contact/">Plan een gesprek <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>

<style>
  .hero { position: relative; overflow: hidden; min-height: min(760px, 84vh); background: var(--green); color: #fff; }
  .hero-content { position: relative; z-index: 1; display: flex; min-height: min(760px, 84vh); flex-direction: column; align-items: flex-start; justify-content: center; padding-block: 5rem; }
  .hero .eyebrow { color: #c5f0d0; }
  h1 { max-width: 13ch; margin: 1.1rem 0; font-size: clamp(3rem, 7vw, 6.5rem); line-height: 0.96; }
  .intro { max-width: 42rem; margin: 0 0 2rem; color: #e2f1e7; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.6; }
  .hero .button-primary { border-color: #fff; background: #fff; color: var(--ink); }
  .hero .button-primary:hover { border-color: var(--coral); background: var(--coral); }
  .hero-index { position: absolute; right: 3%; bottom: 3%; display: flex; align-items: flex-end; gap: 0.6rem; color: #ffffff19; font-weight: 800; line-height: 0.8; }
  .hero-index span:first-child { font-size: clamp(10rem, 34vw, 36rem); }
  .hero-index span:nth-child(2) { padding-bottom: 1.3rem; font-size: clamp(1.5rem, 4vw, 4rem); writing-mode: vertical-rl; }
  .hero-index span:last-child { padding-bottom: 1.4rem; color: #c5f0d0; font-size: 0.8rem; writing-mode: vertical-rl; }
  .services { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 4rem; }
  .section-heading h2, .proof-inner h2, .process-inner h2, .logo-section h2, .final-cta h2 { max-width: 16ch; margin: 0.6rem 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.08; }
  .service-row { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: 1rem; padding-block: 1.25rem; border-top: 1px solid var(--line); text-decoration: none; }
  .service-row > span:first-child, .arrow { color: var(--green); font-weight: 700; }
  .service-row h3 { margin: 0; font-size: 1.35rem; }
  .service-row p { margin: 0.35rem 0 0; color: var(--muted); line-height: 1.55; }
  .service-row:hover h3 { color: var(--green); }
  .proof-band { padding-block: 5rem; background: var(--green-bright); }
  .proof-inner { display: grid; grid-template-columns: 1fr 0.8fr; align-items: center; gap: 3rem; }
  .proof-inner > div:first-child > p:not(.eyebrow) { max-width: 35rem; color: var(--muted); line-height: 1.6; }
  .text-link, .case-placeholder a { color: var(--green); font-weight: 700; text-underline-offset: 0.2em; }
  .case-placeholder { display: flex; min-height: 15rem; flex-direction: column; justify-content: space-between; gap: 1rem; padding: 1.5rem; border: 1px solid var(--green); background: var(--paper); }
  .case-placeholder span { color: var(--green); font-size: 0.8rem; font-weight: 700; }
  .case-placeholder strong { max-width: 18ch; font-size: 1.7rem; }
  .logo-section { padding-block: 5rem; }
  .logo-section h2 { max-width: 22ch; }
  .logo-placeholders { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .logo-placeholders span { display: grid; min-height: 5rem; place-items: center; border: 1px dashed var(--line); color: var(--muted); font-size: 0.85rem; text-align: center; }
  .process-section { padding-block: 5rem; border-block: 1px solid var(--line); background: var(--surface); }
  .process-inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 4rem; }
  .process-inner ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin: 0; padding: 0; list-style: none; }
  .process-inner li { border-top: 2px solid var(--green); padding-top: 1rem; }
  .process-inner li > span { color: var(--green); font-size: 0.8rem; font-weight: 700; }
  .process-inner li h3 { margin: 1.5rem 0 0.5rem; font-size: 1.2rem; }
  .process-inner li p { margin: 0; color: var(--muted); line-height: 1.55; }
  .final-cta { padding-block: 5rem 6rem; }
  .final-cta h2 { margin-bottom: 1.5rem; }
  @media (max-width: 760px) { .services, .proof-inner, .process-inner { grid-template-columns: 1fr; gap: 2rem; } .process-inner ol { grid-template-columns: 1fr; } .process-inner li h3 { margin-top: 0.75rem; } }
  @media (max-width: 520px) { .hero, .hero-content { min-height: 76vh; } .hero-index { right: -14%; bottom: 8%; opacity: 0.7; } .hero-index span:first-child { font-size: 14rem; } .logo-placeholders { grid-template-columns: 1fr; } }
</style>