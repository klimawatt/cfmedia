---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pageDefaults } from '../data/pages';
import { getPageContent, seoProps } from '../lib/cms';
import { breadcrumbSchema } from '../utils/structured-data';

const c = await getPageContent('tarieven', pageDefaults.tarieven);
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Tarieven', href: '/tarieven/' }];
const structuredData = breadcrumbSchema(crumbs);
const packages = [{ name: c.groupName, intro: c.groupIntro, tiers: c.tiers }];
const seo = seoProps(c.seo, { title: 'Tarieven | CF Media', description: 'Bekijk hoe de tarieven van CF Media worden opgebouwd. Bedragen en voorwaarden worden per dienst transparant ingevuld.', canonical: 'https://www.cfmedia.nl/tarieven/' });
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} noindex={seo.noindex} image={seo.image} structuredData={structuredData}>
  <Breadcrumbs items={crumbs} />
  <header class="container page-hero">
    <p class="eyebrow">Kosten en scope</p>
    <h1>{c.heroTitle}</h1>
    <p>{c.heroIntro}</p>
  </header>
  {packages.map((group) => <section class="container package-section" aria-labelledby={`packages-${group.name.toLowerCase()}`}>
    <header class="package-heading"><div><p class="eyebrow">Dienst / {group.name}</p><h2 id={`packages-${group.name.toLowerCase()}`}>{group.name}-pakketten</h2></div><p>{group.intro}</p></header>
    <div class="package-grid">{group.tiers.map((tier, index) => <article class:list={['package-card', { 'is-featured': index === 1 }]}>
      <p class="package-index">0{index + 1} / {group.name}</p>
      <h3>{tier.name}</h3>
      <p class="package-scope">{tier.scope}</p>
      <ul>{tier.includes.map((item) => <li>{item}</li>)}</ul>
      <a class="package-link" href="/contact/">Bespreek dit pakket <span aria-hidden="true">↗</span></a>
    </article>)}</div>
  </section>)}
  <section class="custom-section">
    <div class="container custom-layout"><div><p class="eyebrow">{c.customEyebrow}</p><h2>{c.customTitle}</h2><p>{c.customText}</p><a class="button-primary" href="/diensten/webdesign/">Bekijk webdesign <span aria-hidden="true">↗</span></a></div><ul>{c.customPoints.map((point) => <li>{point}</li>)}</ul></div>
  </section>
  <section class="container pricing-notes">
    <div><p class="eyebrow">Vooraf duidelijk</p><h2>{c.notesTitle}</h2></div>
    <ul>{c.notes.map((note) => <li>{note}</li>)}</ul>
  </section>
  <section class="container pricing-cta"><p class="eyebrow">Een vraag over kosten?</p><h2>{c.ctaTitle}</h2><a class="button-primary" href="/contact/">Plan een gesprek <span aria-hidden="true">↗</span></a></section>
</SiteLayout>

<style>
  .page-hero { padding-block: 4rem 3rem; }
  h1 { max-width: 13ch; margin: 0.75rem 0; font-size: var(--type-h1); line-height: 1.02; }
  .page-hero > p:last-child { max-width: 48rem; color: var(--muted); font-size: 1.15rem; line-height: 1.65; }
  .package-section { padding-bottom: 4rem; }
  .package-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .package-heading h2 { margin: 0.4rem 0 0; font-size: var(--type-h2-medium); }
  .package-heading > p { max-width: 34rem; margin: 0; color: var(--muted); line-height: 1.6; }
  .package-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; padding-top: 1rem; }
  .package-card { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: 1.2rem; border-top: 2px solid var(--line); background: var(--surface); }
  .package-card.is-featured { border-top-color: var(--accent); background: var(--surface-soft); }
  .package-index { margin: 0; color: var(--accent); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; }
  .package-card h3 { margin: 1.2rem 0 0.5rem; font-size: 1.6rem; }
  .package-scope { min-height: 4.5rem; margin: 0; color: var(--muted); line-height: 1.55; }
  .package-card ul { display: grid; gap: 0.55rem; margin: 1rem 0 1.5rem; padding: 0; list-style: none; }
  .package-card li { position: relative; padding-left: 1rem; color: var(--ink); font-size: 0.9rem; line-height: 1.45; }
  .package-card li::before { position: absolute; top: 0.55em; left: 0; width: 0.35rem; height: 0.35rem; background: var(--accent); content: ''; }
  .package-link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: auto; color: var(--accent); font-size: 0.88rem; font-weight: 700; text-underline-offset: 0.15em; }
  .custom-section { padding-block: 4rem; background: var(--night); color: var(--night-ink); }
  .custom-layout { display: grid; grid-template-columns: 1fr 0.8fr; align-items: center; gap: 3rem; }
  .custom-layout .eyebrow { color: var(--accent-on-dark); }
  .custom-layout h2 { max-width: 14ch; margin: 0.5rem 0; font-size: var(--type-h2); line-height: 1.08; }
  .custom-layout > div > p:not(.eyebrow) { max-width: 38rem; margin-bottom: 1.5rem; color: var(--night-muted); line-height: 1.65; }
  .custom-layout ul { display: grid; gap: 0.85rem; margin: 0; padding: 0; list-style: none; }
  .custom-layout li { padding: 0.9rem 0; border-top: 1px solid color-mix(in srgb, var(--night-ink) 25%, transparent); color: var(--night-muted); }
  .pricing-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  .pricing-notes h2, .pricing-cta h2 { max-width: 15ch; margin: 0.5rem 0; font-size: var(--type-h2-medium); line-height: 1.1; }
  .pricing-notes ul { margin: 0; padding-left: 1.2rem; color: var(--muted); line-height: 1.8; }
  .pricing-cta { margin-block: 1rem 5rem; padding: clamp(1.5rem, 5vw, 4rem); background: var(--green-bright); }
  .pricing-cta h2 { margin-bottom: 1.5rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 760px) {
    .package-heading, .custom-layout { align-items: flex-start; grid-template-columns: 1fr; flex-direction: column; gap: 1rem; }
    .package-grid { grid-template-columns: 1fr; }
    .package-scope { min-height: 0; }
    .pricing-notes { grid-template-columns: 1fr; }
  }
</style>