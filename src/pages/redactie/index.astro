---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="Redactie | CF Media" description="Beheeromgeving voor de inhoud van CF Media." canonical="https://www.cfmedia.nl/redactie/" noindex>
  <section class="container redactie" aria-labelledby="redactie-title">
    <h1 id="redactie-title">Redactie</h1>
    <p id="redactie-status" class="redactie-status" role="status"></p>

    <form id="login-form" class="redactie-card" novalidate>
      <h2>Inloggen</h2>
      <div class="field"><label for="login-email">E-mailadres</label><input id="login-email" type="email" autocomplete="username" required /></div>
      <div class="field"><label for="login-password">Wachtwoord</label><input id="login-password" type="password" autocomplete="current-password" required /></div>
      <button class="button-primary" type="submit">Inloggen</button>
    </form>

    <div id="redactie-app" hidden>
      <div class="redactie-toolbar">
        <div class="field"><label for="collection-select">Wat wil je bewerken?</label><select id="collection-select"></select></div>
        <button class="redactie-button" type="button" id="new-entry">Nieuw</button>
        <button class="redactie-button" type="button" id="logout">Uitloggen</button>
      </div>
      <div class="redactie-layout">
        <ul id="entry-list" class="redactie-list" aria-label="Bestaande inhoud"></ul>
        <form id="editor" novalidate hidden>
          <div class="redactie-card">
            <h2 id="editor-title"></h2>
            <div id="editor-fields"></div>
          </div>
          <div class="redactie-card seo-card">
            <h2>SEO</h2>
            <div id="seo-preview" class="seo-preview" aria-label="Voorbeeld in Google"></div>
            <ul id="seo-checks" class="seo-checks"></ul>
            <div id="seo-fields"></div>
          </div>
          <div class="redactie-actions">
            <button class="redactie-button" type="button" id="save-draft">Opslaan als concept</button>
            <button class="button-primary" type="button" id="publish">Publiceren</button>
            <button class="redactie-button danger" type="button" id="delete-entry">Verwijderen</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import '../../lib/redactie';
</script>

<style is:global>
  .redactie { padding-block: 3rem 6rem; }
  .redactie h1 { margin: 0 0 1rem; font-size: var(--type-h2); }
  .redactie-status { min-height: 1.5rem; margin: 0 0 1rem; color: var(--muted); }
  .redactie-status[data-kind='error'] { color: var(--accent); font-weight: 700; }
  .redactie-status[data-kind='ok'] { color: var(--ink); font-weight: 700; }
  .redactie-card { margin-bottom: 1rem; padding: 1.5rem; border: 1px solid var(--line); border-top: 3px solid var(--accent); background: var(--surface); }
  #login-form { max-width: 26rem; }
  .redactie h2 { margin: 0 0 1rem; font-size: 1.4rem; }
  .redactie .field { display: grid; gap: 0.35rem; margin-bottom: 1rem; }
  .redactie label, .redactie .repeater-label { font-size: 0.85rem; font-weight: 700; }
  .redactie input, .redactie textarea, .redactie select { width: 100%; min-width: 0; padding: 0.7rem; border: 1px solid var(--line); border-radius: 0; background: var(--paper); color: var(--ink); }
  .redactie textarea { resize: vertical; line-height: 1.5; }
  .redactie .help { margin: 0; color: var(--muted); font-size: 0.78rem; }
  .redactie-toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem; margin-bottom: 1.5rem; }
  .redactie-toolbar .field { margin: 0; min-width: 14rem; }
  .redactie-layout { display: grid; grid-template-columns: minmax(14rem, 0.5fr) minmax(0, 1.5fr); align-items: start; gap: 1.5rem; }
  .redactie-list { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .redactie-item { display: grid; width: 100%; gap: 0.35rem; padding: 0.8rem; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font-weight: 700; text-align: left; cursor: pointer; }
  .redactie-item:hover { border-color: var(--accent); }
  .redactie .badge { color: var(--muted); font-size: 0.72rem; font-weight: 400; }
  .redactie .badge[data-status='published'] { color: var(--accent); font-weight: 700; }
  .redactie-empty { color: var(--muted); }
  .redactie-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  .redactie-button { min-height: 3rem; padding: 0.7rem 1rem; border: 1px solid var(--ink); background: transparent; color: var(--ink); font-weight: 700; cursor: pointer; }
  .redactie-button.small { min-height: 2.25rem; padding: 0.35rem 0.7rem; font-size: 0.8rem; }
  .redactie-button:hover { background: var(--surface-soft); }
  .redactie-button.danger { margin-left: auto; border-color: var(--line); color: var(--muted); }
  .redactie .button-primary { cursor: pointer; }
  .redactie .repeater-items { display: grid; gap: 0.75rem; margin: 0.5rem 0; }
  .redactie .repeater-item { margin: 0; padding: 1rem; border: 1px solid var(--line); background: var(--paper); }
  .redactie .repeater-item legend { padding-inline: 0.4rem; font-size: 0.8rem; font-weight: 700; color: var(--accent); }
  .redactie .item-bar { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }
  .redactie .seo-preview { display: grid; gap: 0.15rem; margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--line); background: var(--paper); }
  .redactie .snippet-url { color: var(--muted); font-size: 0.78rem; overflow-wrap: anywhere; }
  .redactie .snippet-title { color: var(--accent); font-size: 1.15rem; overflow-wrap: anywhere; }
  .redactie .snippet-description { color: var(--muted); font-size: 0.88rem; line-height: 1.5; }
  .redactie .seo-checks { display: grid; gap: 0.3rem; margin: 0 0 1.25rem; padding: 0; list-style: none; font-size: 0.85rem; }
  .redactie .seo-checks .ok { color: var(--ink); }
  .redactie .seo-checks .bad { color: var(--muted); }
  @media (max-width: 800px) { .redactie-layout { grid-template-columns: 1fr; } }
</style>
