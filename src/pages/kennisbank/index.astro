---
import { ArrowUpRight } from '@lucide/astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { breadcrumbSchema } from '../../utils/structured-data';

const categories = [
  { slug: 'seo', name: 'SEO', description: 'Techniek, inhoud en organische vindbaarheid.' },
  { slug: 'geo', name: 'GEO', description: 'Informatie vindbaar maken in AI-zoekervaringen.' },
  { slug: 'webdesign', name: 'Webdesign', description: 'Websites die helder, toegankelijk en prettig in gebruik zijn.' },
];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Kennisbank', href: '/kennisbank/' }];
const structuredData = breadcrumbSchema(crumbs);
---

<SiteLayout title="Kennisbank | CF Media" description="Lees inzichten over SEO, GEO en webdesign. Praktische uitleg voor betere vindbaarheid en websites die prettig werken." canonical="https://www.cfmedia.nl/kennisbank/" structuredData={structuredData}>
  <Breadcrumbs items={crumbs} />
  <header class="container page-hero">
    <div><p class="eyebrow">CF Media / kennisbank</p><h1>Kennis die je verder brengt.</h1><p>Korte uitleg en praktische inzichten over online vindbaarheid en websites. We publiceren artikelen zodra ze inhoudelijk zijn gecontroleerd.</p></div>
    <div class="editorial-note"><span>CF / REDACTIE</span><strong>Helder antwoord.<br />Praktische volgende stap.</strong><span>SEO · GEO · WEB</span></div>
  </header>
  <section class="container category-list" aria-label="Kennisbankcategorieën">
    {categories.map((category, index) => <a class={`category-card tone-${index}`} href={`/kennisbank/${category.slug}/`}><span class="card-label">0{index + 1} / DOSSIER</span><span class="category-glyph" aria-hidden="true">{category.name.slice(0, 1)}</span><span class="card-content"><h2>{category.name}</h2><p>{category.description}</p><span class="card-link">Bekijk {category.name} <ArrowUpRight size={17} aria-hidden="true" /></span></span></a>)}
  </section>
</SiteLayout>

<style>
  .page-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.7fr); align-items: center; gap: 3rem; padding-block: 3.5rem 4rem; }
  h1 { max-width: 12ch; margin: 0.75rem 0; font-size: var(--type-h1); line-height: 1.02; }
  .page-hero > div:first-child > p:last-child { max-width: 44rem; color: var(--muted); font-size: 1.1rem; line-height: 1.65; }
  .editorial-note { display: flex; min-height: 15rem; flex-direction: column; justify-content: space-between; padding: 1.25rem; background: var(--green-bright); color: var(--ink); }
  .editorial-note span { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; }
  .editorial-note strong { font-size: 1.8rem; line-height: 1.1; }
  .category-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; padding-bottom: 6rem; }
  .category-card { position: relative; display: flex; min-width: 0; min-height: 22rem; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 1.15rem; border-top: 3px solid var(--accent); background: var(--surface-soft); color: var(--ink); text-decoration: none; }
  .tone-0, .tone-1, .tone-2 { background: var(--surface-soft); }
  .card-label { position: relative; z-index: 1; font-size: 0.7rem; font-weight: 700; }
  .category-glyph { position: absolute; top: 2rem; right: -0.5rem; color: color-mix(in srgb, var(--ink) 8%, transparent); font-size: 12rem; font-weight: 800; line-height: 1; }
  .card-content { position: relative; z-index: 1; }
  h2 { margin: 0; font-size: 2rem; }
  .category-card p { max-width: 27ch; min-height: 3rem; margin: 0.5rem 0; line-height: 1.55; }
  .card-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.65rem; font-size: 0.82rem; font-weight: 700; }
  @media (max-width: 760px) { .page-hero { grid-template-columns: 1fr; gap: 1.5rem; } .category-list { grid-template-columns: 1fr; } .category-card { min-height: 17rem; } }
</style>