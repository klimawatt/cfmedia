---
import { ArrowUpRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceContentBlocks from '../../components/ServiceContentBlocks.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import seoDashboard from '../../assets/seo-dashboard.jpg';
import { applyServiceOverrides, resolveLayout, services, type ServiceHub, type ServicePage } from '../../data/services';
import { getOverrideMap, seoProps } from '../../lib/cms';
import { breadcrumbSchema, faqSchema } from '../../utils/structured-data';

export async function getStaticPaths() {
  const resolved = applyServiceOverrides(await getOverrideMap('service'));
  return resolved.flatMap((hub) => [hub, ...hub.subservices]).map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const service = Astro.props.service as ServicePage | ServiceHub;
const isHub = (item: ServicePage | ServiceHub): item is ServiceHub => 'subservices' in item;
const isServiceHub = isHub(service);
const layout = resolveLayout(service.contentBlocks, isServiceHub);
const entryService = isServiceHub && ['seo', 'geo'].includes(service.slug) ? service.subservices[0] : undefined;
const hub = services.find((item) => item.slug === service.hub)!;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Diensten', href: '/diensten/' },
  ...(isServiceHub ? [] : [{ label: hub.name, href: `/diensten/${hub.slug}/` }]),
  { label: service.name, href: `/diensten/${service.slug}/` },
];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  serviceType: service.name,
  url: new URL(`/diensten/${service.slug}/`, 'https://www.cfmedia.nl').href,
  provider: { '@type': 'Organization', name: 'CF Media', url: 'https://www.cfmedia.nl/' },
};
const structuredData = [breadcrumbSchema(crumbs), serviceSchema, ...(isServiceHub ? [faqSchema(service.faq)] : [])];
const seo = seoProps(service.seo, { title: service.title, description: service.description, canonical: `https://www.cfmedia.nl/diensten/${service.slug}/` });
---

<SiteLayout title={seo.title} description={seo.description} canonical={seo.canonical} noindex={seo.noindex} image={seo.image} structuredData={structuredData}>
  <Breadcrumbs items={crumbs} />
  <header class:list={['container', 'page-hero', { 'hub-hero': isServiceHub }]}>
    <div class="hero-copy"><p class="eyebrow">CF Media / {hub.name}</p>
      <h1>{isServiceHub && service.slug === 'geo' ? 'GEO: vindbaar in ChatGPT, Perplexity en Google AI Overviews' : service.name}</h1>
      <p class="summary">{service.summary}</p>
      {isServiceHub && <a class="hero-link" href="#dienstaanbod">Bekijk de mogelijkheden <ArrowUpRight size={17} aria-hidden="true" /></a>}
    </div>
    {isServiceHub && (service.slug === 'seo' ? (
      <figure class="service-visual seo-visual"><Image src={seoDashboard} alt="Laptop met een analyticsdashboard voor websiteverkeer" width={1440} height={960} format="webp" sizes="(max-width: 700px) 100vw, 48vw" loading="lazy" /><figcaption>SEO / zichtbaarheid begint met inzicht</figcaption></figure>
    ) : (
      <aside class={`service-visual service-index ${service.slug}`} aria-label={`Onderdelen van ${service.name}`}><p class="eyebrow">{service.name} / IN DE PRAKTIJK</p><ul>{service.subservices.map((item, index) => <li><span>0{index + 1}</span><a href={`/diensten/${item.slug}/`}>{item.name}<ArrowUpRight size={16} aria-hidden="true" /></a></li>)}</ul><span class="index-signature">CF / {service.slug.toUpperCase()}</span></aside>
    ))}
  </header>

  {entryService && <section class="container entry-service" aria-label={`${entryService.name}, instapdienst`}>
    <div><p class="eyebrow">Een laagdrempelige eerste stap</p><h2>{entryService.name}</h2></div>
    <p>{entryService.summary}</p>
    <a class="text-link" href={`/diensten/${entryService.slug}/`}>Bekijk de audit <span aria-hidden="true">↗</span></a>
  </section>}

  {layout.map((item, index) => item.type !== 'section' ? <ServiceContentBlocks blocks={[item]} startIndex={index} /> : item.section === 'intro' ? (
    isServiceHub ? (
      <section class="container intro-grid">
        <div><h2>Wat is {service.name}?</h2><p>{service.approach}</p></div>
        <div><h2>Voor wie?</h2><p>{service.audience}</p></div>
      </section>
    ) : (
      <section class="container detail-grid">
        <div><p class="eyebrow">Het probleem</p><h2>Waar je tegenaan loopt</h2><p>{service.problem}</p></div>
        <div><p class="eyebrow">De aanpak</p><h2>Wat we doen</h2><p>{service.approach}</p></div>
      </section>
    )
  ) : item.section === 'deliverables' ? (
    <section class="container deliverables">
      <div><p class="eyebrow">Wat je krijgt</p><h2>{isServiceHub ? 'Werk dat je verder helpt' : 'Concreet en inzichtelijk'}</h2></div>
      <ul>{service.deliverables.map((entry) => <li>{entry}</li>)}</ul>
    </section>
  ) : item.section === 'subservices' && isServiceHub ? (
    <section id="dienstaanbod" class="container subservices">
      <p class="eyebrow">{service.name}</p><h2>Waar wil je mee beginnen?</h2>
      <div class="subservice-grid">
        {service.subservices.map((sub) => <article><h3><a href={`/diensten/${sub.slug}/`}>{sub.name}</a></h3><p>{sub.summary}</p><a class="text-link" href={`/diensten/${sub.slug}/`}>Meer over {sub.name} <span aria-hidden="true">↗</span></a></article>)}
      </div>
    </section>
  ) : item.section === 'knowledge' && isServiceHub ? (
    <section class="container knowledge-link">
      <div><p class="eyebrow">Verder lezen</p><h2>Inzichten over {service.name}</h2><p>Bekijk de kennisbankcategorie voor artikelen. Concepten worden pas gepubliceerd na redactie.</p></div>
      <a class="text-link" href={`/kennisbank/${service.category}/`}>Naar de {service.name}-kennisbank <span aria-hidden="true">↗</span></a>
    </section>
  ) : item.section === 'faq' ? (
    <section class="container faq-section"><p class="eyebrow">Veelgestelde vragen</p><h2>{isServiceHub ? `Vragen over ${service.name}` : `Over ${service.name.toLowerCase()}`}</h2><FaqList questions={service.faq} /></section>
  ) : null)}

  <section class="container service-cta"><p class="eyebrow">Een vraag over {service.name}?</p><h2>Leg je situatie aan ons voor.</h2><a class="button-primary" href="/contact/">Plan een gesprek <span aria-hidden="true">↗</span></a></section>
</SiteLayout>

<style>
  .page-hero { padding-block: 3rem 4rem; }
  .hub-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.85fr); align-items: center; gap: 3rem; padding-block: 3rem 4.5rem; }
  .hero-copy { min-width: 0; }
  .hero-link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.4rem; color: var(--green); font-weight: 700; text-underline-offset: 0.2em; }
  .service-visual { position: relative; min-width: 0; min-height: 20rem; margin: 0; overflow: hidden; }
  .seo-visual { background: var(--green-bright); }
  .seo-visual :global(img) { display: block; width: 100%; aspect-ratio: 1.35; object-fit: cover; }
  .seo-visual figcaption { padding: 0.8rem 1rem; font-size: 0.78rem; font-weight: 700; }
  .service-index { display: flex; flex-direction: column; justify-content: space-between; padding: 1.4rem; border-top: 3px solid var(--accent); background: var(--surface-soft); color: var(--ink); }
  .service-index.geo, .service-index.webdesign { background: var(--surface-soft); }
  .service-index .eyebrow { margin-top: 0; color: inherit; }
  .service-index ul { margin: 1rem 0 0; padding: 0; list-style: none; }
  .service-index li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.5rem; padding-block: 0.75rem; border-top: 1px solid var(--line); }
  .service-index li > span { font-size: 0.75rem; font-weight: 700; }
  .service-index li a { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; color: inherit; font-weight: 700; text-decoration: none; }
  .index-signature { align-self: flex-end; margin-top: 1.25rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; }
  .entry-service { display: grid; grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.2fr) auto; align-items: center; gap: 1.25rem; margin-block: 0 3rem; padding: 1.25rem; border-left: 3px solid var(--accent); background: var(--surface-soft); }
  .entry-service .eyebrow { margin: 0 0 0.3rem; }
  .entry-service h2 { margin: 0; font-size: 1.25rem; }
  .entry-service > p { margin: 0; color: var(--muted); line-height: 1.5; }
  .entry-service .text-link { white-space: nowrap; }
  h1 { max-width: 18ch; margin: 0.8rem 0 1rem; font-size: var(--type-h1); line-height: 1.02; }
  .summary { max-width: 48rem; margin: 0; color: var(--muted); font-size: var(--type-lead); line-height: 1.6; }
  h2 { margin: 0.4rem 0 0.8rem; font-size: var(--type-h2-medium); line-height: 1.15; }
  .intro-grid, .detail-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  .intro-grid p:last-child, .detail-grid p:last-child { max-width: 36rem; color: var(--muted); line-height: 1.7; }
  .deliverables { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  .deliverables ul { margin: 0; padding: 0; list-style: none; }
  .deliverables li { padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
  .deliverables li::before { content: '↗'; margin-right: 0.75rem; color: var(--green); }
  .subservices, .faq-section { padding-block: 4rem; border-top: 1px solid var(--line); }
  .subservice-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .subservice-grid article { padding-top: 1rem; border-top: 1px solid var(--line); }
  .subservice-grid h3 { margin: 0; font-size: 1.25rem; }
  .subservice-grid h3 a { text-decoration: none; }
  .subservice-grid p, .knowledge-link p:last-child { color: var(--muted); line-height: 1.6; }
  .text-link { color: var(--green); font-weight: 700; text-underline-offset: 0.2em; }
  .knowledge-link { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 2.5rem; border-top: 1px solid var(--line); }
  .knowledge-link p:last-child { max-width: 42rem; margin-bottom: 0; }
  .faq-section h2 { margin-bottom: 2rem; }
  .service-cta { margin-block: 2rem 5rem; padding: clamp(1.5rem, 5vw, 4rem); background: var(--green-bright); }
  .service-cta h2 { max-width: 16ch; margin: 0 0 1.5rem; font-size: var(--type-h2); }
  @media (max-width: 700px) { .hub-hero { grid-template-columns: 1fr; gap: 1.5rem; } .service-visual { min-height: 0; } .entry-service { grid-template-columns: 1fr; gap: 0.6rem; } .entry-service .text-link { justify-self: start; } .intro-grid, .detail-grid, .deliverables { grid-template-columns: 1fr; gap: 1.2rem; } .subservice-grid { grid-template-columns: 1fr; } .knowledge-link { align-items: flex-start; flex-direction: column; } }
</style>