---
import { ArrowUpRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import seoDashboard from '../../assets/seo-dashboard.jpg';
import { applyServiceOverrides } from '../../data/services';
import { getOverrideMap } from '../../lib/cms';
import { breadcrumbSchema } from '../../utils/structured-data';

const services = applyServiceOverrides(await getOverrideMap('service'));

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Diensten', href: '/diensten/' }];
const structuredData = breadcrumbSchema(crumbs);
---

<SiteLayout title="Diensten | CF Media" description="Bekijk de diensten van CF Media: SEO, GEO en webdesign. Kies de expertise die aansluit bij je website en doelen." canonical="https://www.cfmedia.nl/diensten/" structuredData={structuredData}>
  <Breadcrumbs items={crumbs} />
  <header class="container page-hero">
    <div><p class="eyebrow">Strategie / zichtbaarheid / design</p><h1>Digitale groei begint met de juiste vraag.</h1><p>Van beter gevonden worden tot een website die je verhaal helder vertelt. Kies waar je nu aan wilt werken.</p></div>
    <figure class="hero-image"><Image src={seoDashboard} alt="Laptop met een dashboard met website- en bezoekersgegevens" width={1440} height={960} format="webp" sizes="(max-width: 700px) 100vw, 48vw" loading="lazy" /><figcaption>Inzicht voor een volgende stap <span aria-hidden="true">↗</span></figcaption></figure>
  </header>
  <section class="container service-list" aria-label="Diensten">
    {services.map((service, index) => (
      <a class={`service-card tone-${index}`} href={`/diensten/${service.slug}/`}>
        <span class="service-number">0{index + 1} / CF MEDIA</span>
        <span class="service-orbit" aria-hidden="true">{index === 0 ? 'SEO' : index === 1 ? 'GEO' : 'WEB'}</span>
        <span class="service-card-content"><h2>{service.name}</h2><span class="service-summary">{service.summary}</span><span class="text-link">Bekijk de dienst <ArrowUpRight size={17} aria-hidden="true" /></span></span>
      </a>
    ))}
  </section>
  <section class="case-band"><div class="container case-note"><div><p class="eyebrow">Uit de praktijk</p><h2>Een paar heldere cases zijn genoeg om te beginnen.</h2><p>We delen projecten zodra de aanpak en klantinformatie zijn goedgekeurd.</p></div><a class="case-placeholder" href="/cases/"><span>CASES / CF MEDIA</span><strong>Bekijk hoe we werken aan SEO, GEO en webdesign.</strong><span>Bekijk de cases <ArrowUpRight size={17} aria-hidden="true" /></span></a></div></section>
</SiteLayout>

<style>
  .page-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr); align-items: center; gap: 3rem; padding-block: 3rem 4rem; }
  h1 { max-width: 12ch; margin: 0.75rem 0; font-size: var(--type-h1); line-height: 1.02; }
  .page-hero > div > p:last-child { max-width: 40rem; color: var(--muted); font-size: 1.15rem; line-height: 1.65; }
  .hero-image { position: relative; margin: 0; overflow: hidden; background: var(--green-bright); }
  .hero-image :global(img) { display: block; width: 100%; aspect-ratio: 1.35; object-fit: cover; }
  .hero-image figcaption { display: flex; justify-content: space-between; padding: 0.8rem 1rem; font-size: 0.78rem; font-weight: 700; }
  .service-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; padding-bottom: 5rem; }
  .service-card { position: relative; display: flex; min-width: 0; min-height: 25rem; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 1.2rem; color: var(--ink); text-decoration: none; }
  .tone-0, .tone-1, .tone-2 { border-top: 3px solid var(--accent); background: var(--surface-soft); }
  .service-number { position: relative; z-index: 1; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; }
  .service-orbit { position: absolute; top: 3.2rem; right: -0.5rem; color: color-mix(in srgb, var(--ink) 8%, transparent); font-size: 8rem; font-weight: 800; line-height: 1; transform: rotate(90deg); transform-origin: top right; }
  .service-card-content { position: relative; z-index: 1; }
  .service-card h2 { margin: 0 0 0.6rem; font-size: 2rem; }
  .service-summary { display: block; max-width: 28ch; min-height: 4rem; line-height: 1.55; }
  .text-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; font-weight: 700; text-underline-offset: 0.15em; }
  .case-band { padding-block: 4.5rem; background: var(--green-bright); }
  .case-note { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: center; gap: 3rem; }
  .case-note h2 { max-width: 14ch; margin: 0.6rem 0; font-size: 2.4rem; line-height: 1.1; }
  .case-note > div > p:last-child { max-width: 35rem; line-height: 1.6; }
  .case-placeholder { display: flex; min-height: 15rem; flex-direction: column; justify-content: space-between; padding: 1.3rem; background: var(--night); color: var(--night-ink); text-decoration: none; }
  .case-placeholder > span { display: flex; align-items: center; gap: 0.45rem; font-size: 0.78rem; font-weight: 700; }
  .case-placeholder strong { max-width: 20ch; font-size: 1.7rem; }
  @media (max-width: 760px) { .page-hero { grid-template-columns: 1fr; gap: 1.5rem; } .service-list { grid-template-columns: 1fr; } .service-card { min-height: 18rem; } .service-orbit { top: 2.4rem; font-size: 6rem; } .case-note { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>