---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { breadcrumbSchema } from '../../utils/structured-data';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((item) => ({ params: { slug: item.id.split('/').at(-1)! }, props: { item } }));
}

const { item } = Astro.props;
const slug = item.id.split('/').at(-1)!;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Cases', href: '/cases/' },
  { label: item.data.title, href: `/cases/${slug}/` },
];
const structuredData = breadcrumbSchema(crumbs);
---

<SiteLayout title="Case-opzet | CF Media" description={item.data.description} canonical={`https://www.cfmedia.nl/cases/${slug}/`} structuredData={structuredData}>
  <Breadcrumbs items={crumbs} />
  <header class="container page-hero">
    <p class="eyebrow">Case · {item.data.serviceTags.length ? item.data.serviceTags.join(' · ') : 'Dienst invullen'}</p>
    <h1>{item.data.title}</h1>
    <p>{item.data.description}</p>
  </header>
  <article class="container case-content">
    <section><h2>De vraag</h2><p>{item.data.problem}</p></section>
    <section><h2>De aanpak</h2><p>{item.data.approach}</p></section>
    <section><h2>Het resultaat</h2><p>{item.data.result}</p></section>
    <p class="notice">Deze pagina bevat invulvelden. Vervang de placeholders en controleer toestemming voordat je de case publiceert.</p>
    <a class="text-link" href="/diensten/">Bekijk de diensten van CF Media <span aria-hidden="true">↗</span></a>
  </article>
</SiteLayout>

<style>
  .page-hero { padding-block: 4rem 3rem; }
  h1 { max-width: 16ch; margin: 0.75rem 0; font-size: clamp(2.8rem, 6vw, 5.5rem); line-height: 1; overflow-wrap: anywhere; }
  .page-hero > p:last-child { max-width: 44rem; color: var(--muted); font-size: 1.15rem; line-height: 1.6; }
  .case-content { max-width: 50rem; padding-bottom: 6rem; }
  section { padding-block: 1.5rem; border-top: 1px solid var(--line); }
  h2 { margin: 0 0 0.7rem; font-size: 1.4rem; }
  section p { color: var(--muted); line-height: 1.7; }
  .notice { margin-block: 2rem; padding: 1rem; border-left: 3px solid var(--coral); background: var(--surface); line-height: 1.6; }
  .text-link { color: var(--green); font-weight: 700; text-underline-offset: 0.2em; }
</style>