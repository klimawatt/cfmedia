---
import { Image } from 'astro:assets';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import portraitPlaceholder from '../../assets/team-placeholder.svg';
import { breadcrumbSchema } from '../../utils/structured-data';

export function getStaticPaths() {
  const team = {
    slug: 'teamlid-invullen',
    name: '[NAAM TEAMLID INVULLEN]',
    jobTitle: '[FUNCTIE INVULLEN]',
    description: '[KORTE BIO INVULLEN]',
    photo: portraitPlaceholder,
  };
  return [{ params: { slug: team.slug }, props: { team } }];
}

const { team } = Astro.props;
const canonical = `https://www.cfmedia.nl/over-ons/${team.slug}/`;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Over ons', href: '/over-ons/' },
  { label: team.name, href: `/over-ons/${team.slug}/` },
];
const structuredData = [breadcrumbSchema(crumbs), {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: team.name,
  jobTitle: team.jobTitle,
  description: team.description,
  image: new URL(team.photo.src, Astro.site).href,
  worksFor: { '@type': 'Organization', name: 'CF Media', url: 'https://www.cfmedia.nl/' },
  url: canonical,
}];
---

<SiteLayout title={`${team.name} | CF Media`} description={`${team.jobTitle} bij CF Media. ${team.description}`} canonical={canonical} structuredData={structuredData}>
  <Breadcrumbs items={crumbs} />
  <article class="container profile">
    <Image src={team.photo} alt={`Placeholder voor de profielfoto van ${team.name}`} width={320} height={320} />
    <div><p class="eyebrow">Team CF Media</p><h1>{team.name}</h1><p class="job-title">{team.jobTitle}</p><p>{team.description}</p><p class="notice">Dit is een profielopzet. Vervang naam, functie, bio en foto voordat je de pagina publiceert.</p><a class="text-link" href="/over-ons/">Terug naar Over ons <span aria-hidden="true">↗</span></a></div>
  </article>
</SiteLayout>

<style>
  .profile { display: grid; grid-template-columns: minmax(12rem, 20rem) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 7vw, 6rem); padding-block: 4rem 7rem; }
  .profile :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  h1 { max-width: 15ch; margin: 0.75rem 0; font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.02; overflow-wrap: anywhere; }
  .job-title { font-weight: 700; }
  .profile > div > p:not(.eyebrow) { color: var(--muted); line-height: 1.65; }
  .notice { margin-block: 2rem; padding: 1rem; border-left: 3px solid var(--coral); background: var(--surface); }
  .text-link { color: var(--green); font-weight: 700; text-underline-offset: 0.2em; }
  @media (max-width: 650px) { .profile { grid-template-columns: minmax(0, 1fr); } .profile :global(img) { max-width: 20rem; } }
</style>